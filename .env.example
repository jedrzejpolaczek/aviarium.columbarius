# Environment variables for aviarium.columbarius
#
# Copy this file to docker/.env (the path docker-compose.yml reads via env_file)
# and fill in the values. Never commit the filled-in file — .env is gitignored.
#
#   cp .env.example docker/.env
#
# Every variable below is optional: the application starts without any of them,
# but with reduced capability (see each entry).


# ─────────────────────────────────────────────────────────────────────────────
# Model serving
# ─────────────────────────────────────────────────────────────────────────────

# MLflow run_id of the model the API should load at startup.
# Printed by `make train` / `uv run python -m scripts.train_model`.
# Unset -> API starts in degraded mode: /health and /cards work, /predict
# returns 503. Required for predictions.
MODEL_RUN_ID=

# Path to the Gold DuckDB file, as seen from inside the container.
# Default (unset): data/gold/cards.duckdb
GOLD_DB_PATH=/app/data/gold/cards.duckdb

# MLflow tracking store. The docker-compose services mount the root mlflow.db
# read-only at /app/mlflow.db.
# Default (unset): the value of _DEFAULT_TRACKING_URI in
# src/ml/training/tracking.py.
MLFLOW_TRACKING_URI=sqlite:////app/mlflow.db


# ─────────────────────────────────────────────────────────────────────────────
# API access
# ─────────────────────────────────────────────────────────────────────────────

# Shared secret for POST /admin/reload-model, compared in constant time
# against the X-Admin-Token request header.
# Unset -> the endpoint returns 503 and hot model reload is unavailable
# (rollback then requires editing docker/.env and restarting the container).
# Use a long random value, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Comma-separated list of browser origins allowed to call the API.
# Default (unset): http://localhost:3000,http://127.0.0.1:3000
# Set this when the frontend is served from any other host or port.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ─────────────────────────────────────────────────────────────────────────────
# Alerting (see ADR-031)
# ─────────────────────────────────────────────────────────────────────────────

# Incoming-webhook URL (Slack / Discord / Mattermost compatible). send_alert()
# posts there in addition to writing logs/alerts.jsonl and raising a desktop
# notification.
# Unset -> alerts are recorded locally only; nobody is paged remotely.
ALERT_WEBHOOK_URL=

# Dead-man's-switch URL pinged on every scripts/check_and_retrain.py run
# (a "/fail" suffix is appended on failure). Lets an external monitor notice
# that the scheduled job has stopped running at all.
# Unset -> no heartbeat is sent; a silently dead scheduled task goes unnoticed.
HEARTBEAT_URL=
